# Copy to .env and adjust. All variables are optional; defaults are shown.
# Large artefacts are kept outside the OneDrive-synced project folder (ADR-7).
DSCI41_DATA_ROOT=C:/Users/<you>/dsci41/data
DSCI41_MODELS_ROOT=C:/Users/<you>/dsci41/models
DSCI41_LOG_DIR=C:/Users/<you>/dsci41/logs
DSCI41_LOG_LEVEL=INFO
# auto | cpu | cuda | xpu | openvino   (falls back to cpu when unavailable)
DSCI41_DEVICE=auto

# Used by uv when syncing dependencies (see scripts/setup_env.ps1)
UV_PROJECT_ENVIRONMENT=C:/Users/<you>/dsci41/venv
