# Single-file Hugging Face Space: paste this as the Space's only `Dockerfile` (Docker SDK, blank template).
# It builds the dashboard from the public GitHub repository, so no tokens, secrets or file uploads are needed.
# To deploy a newer version later: Space -> Settings -> Factory rebuild (the ADD line below notices new commits).
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv

RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.venv/bin:$PATH \
    UV_PROJECT_ENVIRONMENT=/home/user/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DSCI41_HOSTED=true \
    DSCI41_DATA_ROOT=/tmp/dsci41/data \
    DSCI41_MODELS_ROOT=/home/user/models \
    DSCI41_LOG_DIR=/tmp/dsci41/logs \
    DSCI41_REPORTS_ROOT=/tmp/dsci41/reports \
    DSCI41_DEVICE=cpu \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    YOLO_AUTOINSTALL=false

ARG REPO=Pavansailahar/Traffic-Volume-Estimation-and-Short-Term-Congestion-Forecasting-from-Roadside-Video
# Changes whenever main gets a new commit, so a rebuild picks up the latest code.
ADD https://api.github.com/repos/${REPO}/commits/main /tmp/latest-commit.json
WORKDIR /home/user
RUN git clone --depth 1 https://github.com/${REPO}.git repo \
    && python3 repo/scripts/build_hf_space.py --out app \
    && rm -rf repo

WORKDIR /home/user/app
RUN uv sync --frozen --no-dev --no-install-project
RUN python -c "import src; from src.common.config import Settings; from src.detection.detector import ensure_weights; print(ensure_weights('yolo11n.pt', Settings().models_root))"

EXPOSE 7860
CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port", "7860", "--server.address", "0.0.0.0", \
     "--server.headless", "true", "--server.maxUploadSize", "200", \
     "--server.enableXsrfProtection", "false", "--server.enableCORS", "false", \
     "--browser.gatherUsageStats", "false"]
